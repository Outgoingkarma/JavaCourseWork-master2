<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="334.0" prefWidth="857.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.fxControllers.CreateFoodOrder">
    <children>
        <Button fx:id="foodOrderSaveButton" layoutX="392.0" layoutY="271.0" mnemonicParsing="false" onAction="#saveFoodOrder" text="Save" />
        <ComboBox fx:id="foodOrderRestaurant" layoutX="337.0" layoutY="62.0" prefWidth="150.0" promptText="Restaurant" />
        <ComboBox fx:id="foodOrderClient" layoutX="337.0" layoutY="97.0" prefWidth="150.0" promptText="Client" />
        <ComboBox fx:id="foodOrderStatus" layoutX="337.0" layoutY="201.0" prefWidth="150.0" promptText="Status" />
        <TextField fx:id="foodOrderAddress" layoutX="338.0" layoutY="166.0" promptText="Address" />
        <ComboBox fx:id="foodOrderDriver" layoutX="338.0" layoutY="132.0" prefWidth="150.0" promptText="Driver" />
        <ListView fx:id="foodOrderList" layoutX="596.0" layoutY="45.0" prefHeight="200.0" prefWidth="200.0" />
        <Button fx:id="foodOrderDishAdd" layoutX="140.0" layoutY="258.0" mnemonicParsing="false" onAction="#addDishToFoodOrder" text="Add" />
        <ListView fx:id="dishList" layoutX="59.0" layoutY="46.0" prefHeight="200.0" prefWidth="200.0" />
        <Button fx:id="foodOrderDishDelete" layoutX="677.0" layoutY="258.0" mnemonicParsing="false" onAction="#deleteDishesFromFoodOrder" text="Remove" />
        <Label layoutX="338.0" layoutY="242.0" text="Total price:" />
        <Label fx:id="foodOrderTotalPrice" layoutX="414.0" layoutY="242.0" text="0.00" />
    </children>
</AnchorPane>
