<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="567.0" prefWidth="827.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.coursework.fxControllers.MainForm">
    <children>
        <TabPane fx:id="mainTabPane" layoutY="-7.0" prefHeight="598.0" prefWidth="905.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="userTab" onSelectionChanged="#reloadUserTab" text="User management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="609.0" prefWidth="930.0">
                            <children>
                                <TableView fx:id="userTable" layoutX="-4.0" layoutY="41.0" prefHeight="536.0" prefWidth="861.0">
                                    <columns>
                                        <TableColumn fx:id="userIdColumn" prefWidth="75.0" text="ID" />
                                        <TableColumn fx:id="userLoginColumn" prefWidth="75.0" text="Login" />
                                        <TableColumn fx:id="userPasswordColumn" prefWidth="75.0" text="Password" />
                                        <TableColumn fx:id="userNameColumn" prefWidth="75.0" text="Name" />
                                        <TableColumn fx:id="userSurnameColumn" prefWidth="75.0" text="Surname" />
                                        <TableColumn fx:id="userEmailColumn" prefWidth="75.0" text="Email" />
                                        <TableColumn fx:id="userPhoneColumn" prefWidth="75.0" text="Phone" />
                                        <TableColumn fx:id="userAddressColumn" prefWidth="75.0" text="Address" />
                                        <TableColumn fx:id="userTypeColumn" prefWidth="75.0" text="Type" />
                                    </columns>
                                </TableView>
                                <Button fx:id="createNewUserButton" layoutX="11.0" layoutY="11.0" mnemonicParsing="false" onAction="#createNewUser" prefHeight="24.0" prefWidth="103.0" text="Create new user" />
                                <Button fx:id="editUserButton" layoutX="123.0" layoutY="11.0" mnemonicParsing="false" onAction="#editUser" text="Edit user" />
                                <Button fx:id="deleteUserButton" layoutX="194.0" layoutY="11.0" mnemonicParsing="false" onAction="#deleteUser" text="Delete user" />
                                <Button fx:id="filterButton" layoutX="636.0" layoutY="11.0" mnemonicParsing="false" onAction="#filterData" text="Filter" />
                                <TextField fx:id="filterName" layoutX="396.0" layoutY="11.0" prefHeight="25.0" prefWidth="102.0" promptText="Searching name" />
                                <TextField fx:id="filterSurname" layoutX="508.0" layoutY="11.0" prefHeight="25.0" prefWidth="118.0" promptText="Searching surname" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="orderTab" onSelectionChanged="#reloadOrderTab" text="Order management">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <TableView fx:id="orderTable" layoutY="46.0" prefHeight="525.0" prefWidth="612.0">
                                    <columns>
                                        <TableColumn fx:id="orderIDColumn" prefWidth="75.0" text="Order ID" />
                                        <TableColumn fx:id="orderCustomerColumn" prefWidth="75.0" text="Customer" />
                                        <TableColumn fx:id="orderRestaurantColumn" prefWidth="75.0" text="Restaurant" />
                                        <TableColumn fx:id="orderDriverColumn" prefWidth="75.0" text="Driver" />
                                        <TableColumn fx:id="orderStatusColumn" prefWidth="76.0" text="Status" />
                                        <TableColumn fx:id="orderDateColumn" prefWidth="174.0" text="Date" />
                                        <TableColumn fx:id="foodOrderPrice" prefWidth="61.0" text="Ord price" />
                                    </columns>
                                </TableView>
                                <Button fx:id="orderaddOrderButton" layoutX="14.0" layoutY="5.0" mnemonicParsing="false" onAction="#createOrder" text="Add order" />
                                <Button fx:id="orderUpdateStatusButton" layoutX="95.0" layoutY="5.0" mnemonicParsing="false" onAction="#updateOrder" text="Update status" />
                                <Button fx:id="deleteOrderButton" layoutX="196.0" layoutY="5.0" mnemonicParsing="false" onAction="#deleteOrder" text="Delete order" />
                                <Button fx:id="openChatButton" layoutX="292.0" layoutY="5.0" mnemonicParsing="false" onAction="#openChat" text="Open chat" />
                                <ListView fx:id="orderedFoodList" layoutX="625.0" layoutY="46.0" prefHeight="512.0" prefWidth="255.0" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="restaurantMenuTab" onSelectionChanged="#reloadRestaurantTab" text="Restaurant menu">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="613.0" prefWidth="902.0">
                            <children>
                                <ListView fx:id="restaurantsList" layoutX="20.0" layoutY="41.0" prefHeight="501.0" prefWidth="200.0" />
                                <TableView fx:id="restaurantMenuTable" layoutX="250.0" layoutY="47.0" prefHeight="246.0" prefWidth="422.0">
                                    <columns>
                                        <TableColumn fx:id="dishIDColumn" prefWidth="25.0" text="ID" />
                                        <TableColumn fx:id="dishNameColumn" prefWidth="165.0" text="DIsh name" />
                                        <TableColumn fx:id="dishTypeColumn" prefWidth="112.0" text="Type" />
                                        <TableColumn fx:id="dishPortionSizeColumn" prefWidth="76.0" text="Portion size" />
                                        <TableColumn fx:id="dishPriceColumn" prefWidth="43.0" text="Price" />
                                    </columns>
                                </TableView>
                                <ListView fx:id="allDishIngredientsList" layoutX="242.0" layoutY="316.0" prefHeight="200.0" prefWidth="200.0" />
                                <Button fx:id="addDishButton" layoutX="250.0" layoutY="16.0" mnemonicParsing="false" onAction="#addDishToMenu" text="Add" />
                                <Button fx:id="removeDishButton" layoutX="299.0" layoutY="16.0" mnemonicParsing="false" onAction="#removeDishFromMenu" text="Remove" />
                                <TextArea fx:id="dishDescription" layoutX="702.0" layoutY="64.0" prefHeight="200.0" prefWidth="189.0" promptText="Dish description" />
                                <Text layoutX="89.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Restaurants" />
                                <Text layoutX="754.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dish description" />
                                <Text layoutX="287.0" layoutY="311.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Available ingredients" />
                                <ListView fx:id="selectedDishIngredientsList" layoutX="460.0" layoutY="317.0" prefHeight="200.0" prefWidth="200.0" />
                                <Text layoutX="516.0" layoutY="311.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dish ingredients" />
                                <Button fx:id="removeIngredientsButton" layoutX="475.0" layoutY="529.0" mnemonicParsing="false" onAction="#removeIngredientsFromDish" text="Remove ingredients from dish" />
                                <Button fx:id="addIngredientsButton" layoutX="274.0" layoutY="529.0" mnemonicParsing="false" onAction="#addIngredientsToDish" text="Add ingredients to dish" />
                                <Button fx:id="editDishButton" layoutX="747.0" layoutY="272.0" mnemonicParsing="false" onAction="#editDishInMenu" text="Edit description" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
